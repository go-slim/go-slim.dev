{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "go-docs",
  "main": "./workers/site.ts",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/__llms__/*"
    ],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_BUDGET",
        "class_name": "AiDailyBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AiDailyBudget"
      ]
    }
  ]
}
