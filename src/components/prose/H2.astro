---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h2">;
const { class: className, ...rest } = Astro.props;
---

<h2
  class:list={[
    "mt-11 mb-4 scroll-mt-24 pt-8 text-[1.75rem] leading-[1.2] font-semibold tracking-heading",
    className,
  ]}
  {...rest}
>
  <slot />
</h2>
