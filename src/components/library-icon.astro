---
type Props = {
  icon: string
  class?: string
}

const { icon, class: className = 'size-5' } = Astro.props
const modules = import.meta.glob<{ default: string }>(
  '../assets/icons/*.svg',
  { eager: true, query: '?raw' },
)
const name = icon.split('/').pop() ?? icon
const source = modules[`../assets/icons/${name}`]?.default
---

{source ? (
  <span
    class:list={['library-icon inline-flex items-center justify-center', className]}
    aria-hidden="true"
  >
    <Fragment set:html={source} />
  </span>
) : (
  <span
    class:list={['inline-block rounded-sm border border-current', className]}
    aria-hidden="true"
  />
)}

<style>
  .library-icon > svg {
    width: 100%;
    height: 100%;
  }
</style>
