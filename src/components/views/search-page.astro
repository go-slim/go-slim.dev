---
import { Icon } from 'astro-icon/components'
import Button from '#components/ui/button/index.astro'
import Feedback from '#components/search/feedback.astro'
import type { ContentLocale } from '#lib/content-types.ts'
import {
  getTranslationTemplate,
  useTranslations,
} from '#i18n/utils.ts'

type Props = { locale: ContentLocale }

const { locale } = Astro.props
const t = useTranslations(locale)
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '')
const path = `${basePath}${locale === 'zh-Hans' ? '/zh-Hans' : ''}/search`
const pageData = `searchPage(${JSON.stringify({
  locale,
  path,
  unavailableMessage: t('search.unavailable'),
  resultCountTemplates: {
    one: getTranslationTemplate(locale, 'search.resultCount.one'),
    other: getTranslationTemplate(locale, 'search.resultCount.other'),
  },
  pageStatusTemplate: getTranslationTemplate(locale, 'search.pageStatus'),
  pageNumberTemplate: getTranslationTemplate(locale, 'search.pageNumber'),
  groupLabels: {
    site: t('search.siteSearch'),
    libraries: t('header.nav.libraries'),
    blog: t('header.nav.blog'),
    community: t('header.nav.community'),
  },
})})`
---

<main
  x-data={pageData}
  data-pagefind-ignore
  class="mx-auto w-full min-w-0 max-w-4xl px-4 py-12 @[48rem]/app:px-6 @[64rem]/app:px-8 @[64rem]/app:py-18"
>
  <header class="min-w-0 max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-display">
      {t('search.pageHeading')}
    </h1>
    <form action={path} method="get" class="mt-8 flex gap-2">
      <label class="min-w-0 flex-1">
        <span class="sr-only">{t('search.inputLabel')}</span>
        <input
          type="search"
          name="q"
          x-model="query"
          value=""
          placeholder={t('search.placeholder')}
          class="h-12 w-full rounded-lg border border-border bg-card px-4 outline-hidden focus-visible:ring-3 focus-visible:ring-outline/50"
        />
      </label>
      <Button type="submit" variant="primary" class="h-12">
        <Icon name="tabler:search" class="size-5" aria-hidden="true" />
        {t('search.submit')}
      </Button>
    </form>
  </header>

  <section class="relative mt-10 min-h-80 min-w-0" aria-label={t('search.regionLabel')}>
    <Feedback locale={locale} type="no-query" x-show="status === 'idle'" />
    <Feedback locale={locale} type="loading" x-show="status === 'loading'" x-cloak />
    <Feedback locale={locale} type="no-results" x-show="status === 'empty'" x-cloak />
    <Feedback locale={locale} type="error" x-show="status === 'error'" x-cloak>
      <span x-text="error">{t('search.unavailable')}</span>
    </Feedback>

    <div x-show="status === 'ready'" x-cloak>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3 text-sm text-muted-foreground">
        <p x-text="resultCountLabel"></p>
        <p x-show="totalPages > 1" x-text="pageStatusLabel"></p>
      </div>

      <ul class="space-y-10" role="list">
        <template x-for="group in groups" :key="group.id">
          <li class="min-w-0">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-muted-foreground" x-text="group.label"></h2>
            <ul class="grid gap-2 @[48rem]/app:grid-cols-2" role="list">
              <template x-for="result in group.items" :key="result.id">
                <li class="min-w-0">
                  <a
                    :href="result.url"
                    class="group flex min-h-20 min-w-0 w-full items-center rounded-lg border border-border bg-card p-3 outline-hidden transition-colors hover:border-outline focus-visible:ring-3 focus-visible:ring-outline/50"
                  >
                    <span class="flex size-11 shrink-0 items-center justify-center text-muted-foreground group-hover:text-primary">
                      <Icon name="tabler:hash" class="size-5" aria-hidden="true" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <strong class="block truncate font-medium" x-text="result.title"></strong>
                      <span class="mt-1 block truncate text-sm text-muted-foreground" x-text="result.excerpt"></span>
                    </span>
                    <Icon name="tabler:arrow-up-right" class="ms-3 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                  </a>
                </li>
              </template>
            </ul>
          </li>
        </template>
      </ul>

      <nav
        x-show="totalPages > 1"
        class="mt-12 flex flex-wrap items-center justify-center gap-2"
        aria-label={t('search.pagination')}
      >
        <a
          x-show="page > 1"
          :href="pageHref(page - 1)"
          class="inline-flex h-10 items-center rounded-md border border-border px-3 hover:bg-muted"
        >
          <Icon name="tabler:chevron-left" class="size-4" aria-hidden="true" />
          {t('search.previous')}
        </a>
        <template x-for="pageNumber in paginationPages" :key="pageNumber">
          <a
            :href="pageHref(pageNumber)"
            :aria-current="pageNumber === page ? 'page' : null"
            :aria-label="pageNumber === page ? pageStatusLabel : pageNumberLabel(pageNumber)"
            class="inline-flex size-10 items-center justify-center rounded-md border border-border hover:bg-muted aria-current:bg-primary aria-current:text-primary-foreground"
            x-text="pageNumber"
          ></a>
        </template>
        <a
          x-show="page < totalPages"
          :href="pageHref(page + 1)"
          class="inline-flex h-10 items-center rounded-md border border-border px-3 hover:bg-muted"
        >
          {t('search.next')}
          <Icon name="tabler:chevron-right" class="size-4" aria-hidden="true" />
        </a>
      </nav>
    </div>
  </section>
</main>
