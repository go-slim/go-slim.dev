---
import { Icon } from 'astro-icon/components'
import Item from '#components/ui/item/index.astro'
import LibraryIcon from '#components/library-icon.astro'
import LibraryStatusBadge from '#components/ui/library-status-badge.astro'
import { getLibraryCatalog } from '#lib/content.ts'
import type { ContentLocale } from '#lib/content-types.ts'
import {
  useTranslations,
  type TranslationKeyWithoutParameters,
} from '#i18n/utils.ts'

type Props = {
  locale: ContentLocale
}

const { locale } = Astro.props
const groups = await getLibraryCatalog(locale)
const t = useTranslations(locale)
const descriptionKeys: Record<string, TranslationKeyWithoutParameters> = {
  web: 'libraries.group.web',
  data: 'libraries.group.data',
  tools: 'libraries.group.tools',
}
---

<main>
  <header class="relative isolate overflow-hidden border-b border-border">
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_20%,rgb(221_214_254/0.55),transparent_28%),radial-gradient(circle_at_82%_70%,rgb(224_231_255/0.45),transparent_30%)] dark:opacity-30"
      aria-hidden="true"
    />
    <div class="mx-auto max-w-page px-4 py-18 @[48rem]/app:px-6 @[64rem]/app:px-8 @[64rem]/app:py-24">
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-primary">
        <Icon name="tabler:packages" class="size-4" aria-hidden="true" />
        {t('libraries.eyebrow')}
      </p>
      <h1 class="mt-5 max-w-4xl text-page-title text-balance font-semibold tracking-display">
        {t('libraries.title')}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
        {t('libraries.description')}
      </p>
      <nav class="mt-10 flex flex-wrap gap-3" aria-label={t('libraries.areas')}>
        {groups.map((group) => (
          <a
            href={`#${group.id}`}
            class="rounded-full border border-border bg-card/70 px-4 py-2 text-sm font-medium transition-colors hover:border-foreground"
          >
            {group.title} · {group.items.length}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <div class="mx-auto max-w-page space-y-20 px-4 py-16 @[48rem]/app:px-6 @[64rem]/app:px-8 @[64rem]/app:py-24">
    {groups.map((group) => (
      <section id={group.id} class="scroll-mt-24">
        <div class="grid gap-8 @[64rem]/app:grid-cols-[18rem_1fr]">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
              {group.title}
            </p>
            <h2 class="mt-3 text-3xl font-semibold">
              {t('libraries.groupTitle', { group: group.title })}
            </h2>
            <p class="mt-4 leading-7 text-muted-foreground">
              {descriptionKeys[group.id] ? t(descriptionKeys[group.id]) : undefined}
            </p>
          </div>
          <div class="grid gap-4 @[48rem]/app:grid-cols-2">
            {group.items.map((item) => (
              <Item
                href={item.href}
                title={item.name}
                subtitle={item.description}
                class="group items-start gap-4 rounded-xl border border-border bg-card p-5 hover:border-outline"
                leadingClass="rounded-lg bg-muted p-3 text-primary"
                titleClass="text-xl font-bold"
                subtitleClass="mt-2 block leading-6 text-muted-foreground"
              >
                <Fragment slot="leading">
                  <span class="inline-flex">
                    <LibraryIcon icon={item.icon} class="size-6" />
                  </span>
                </Fragment>
                <Fragment slot="meta">
                  <LibraryStatusBadge
                    status={item.status}
                    locale={locale}
                  />
                </Fragment>
                <Fragment slot="trailing">
                  <Icon
                    name="tabler:arrow-up-right"
                    class="size-5 text-muted-foreground/60 group-hover:text-primary"
                    aria-hidden="true"
                  />
                </Fragment>
              </Item>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
</main>
