---
type Props = {
  title?: string
  type?: 'note' | 'tip' | 'info' | 'warning' | 'danger'
}

const { title, type = 'note' } = Astro.props
const classes = {
  note: 'border-primary/40 bg-primary/10 text-primary-accent',
  tip: 'border-success/40 bg-success/10 text-success',
  info: 'border-info/40 bg-info/10 text-info',
  warning: 'border-warning/40 bg-warning/10 text-warning',
  danger: 'border-error/40 bg-error/10 text-error',
}
---

<aside class:list={['my-6 rounded-lg border px-5 py-4', classes[type]]}>
  {title && (
    <div class="relative mb-1 font-semibold before:absolute before:-left-5 before:top-1/2 before:h-[120%] before:w-1 before:-translate-x-px before:-translate-y-1/2 before:rounded-r-sm before:bg-current">
      {title}
    </div>
  )}
  <div class="[&>*:first-child]:mt-0 [&>*:last-child]:mb-0"><slot /></div>
</aside>
