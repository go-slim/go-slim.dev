---
import type { HTMLAttributes } from 'astro/types'
import { Icon } from 'astro-icon/components'
import { useTranslations } from '#i18n/utils.ts'
import type { UiTranslationKey } from '#i18n/ui.ts'
import type { ContentLocale } from '#lib/content-types.ts'

type FeedbackType = 'no-results' | 'no-query' | 'loading' | 'error'

type AlpineAttributes = {
  [key: `x-${string}`]: string | boolean | undefined
  [key: `@${string}`]: string | undefined
  [key: `:${string}`]: string | undefined
}

type Props = Omit<HTMLAttributes<'div'>, 'class'> &
  AlpineAttributes & {
    locale: ContentLocale
    type: FeedbackType
    message?: string
    class?: HTMLAttributes<'div'>['class']
  }

const feedback = {
  'no-results': {
    icon: 'tabler:file-search',
    messageKey: 'search.noResults',
    role: 'status',
    live: 'polite',
  },
  'no-query': {
    icon: 'tabler:text-regex-question',
    messageKey: 'search.noQuery',
    role: undefined,
    live: 'off',
  },
  loading: {
    icon: 'tabler:loader-2',
    messageKey: 'search.loading',
    role: 'status',
    live: 'polite',
  },
  error: {
    icon: 'tabler:alert-circle',
    messageKey: 'search.error',
    role: 'alert',
    live: 'assertive',
  },
} as const satisfies Record<
  FeedbackType,
  {
    icon: string
    messageKey: UiTranslationKey
    role: 'status' | 'alert' | undefined
    live: 'off' | 'polite' | 'assertive'
  }
>

const {
  locale,
  type,
  message,
  class: className,
  ...rest
} = Astro.props
const t = useTranslations(locale)
const state = feedback[type]
const hasActions = Astro.slots.has('actions')
---

<div
  {...rest}
  data-state={type}
  role={state.role}
  aria-live={state.live}
  aria-busy={type === 'loading' ? 'true' : undefined}
  class:list={[
    'flex min-h-52 flex-col items-center justify-center px-6 py-10 text-center',
    type === 'error' ? 'text-error' : 'text-muted-foreground',
    className,
  ]}
>
  <span
    class:list={[
      'inline-flex size-18 items-center justify-center rounded-full bg-muted',
      type === 'error' && 'bg-error/10',
    ]}
    aria-hidden="true"
  >
    <Icon
      name={state.icon}
      class:list={[
        'size-10',
        type === 'loading' && 'animate-spin motion-reduce:animate-none',
      ]}
    />
  </span>
  <p class="mt-3 max-w-sm text-sm">
    <slot>{message ?? t(state.messageKey)}</slot>
  </p>
  {hasActions && (
    <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
      <slot name="actions" />
    </div>
  )}
</div>
