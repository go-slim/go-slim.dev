---
import { Icon } from 'astro-icon/components'
import Button from '#components/ui/button/index.astro'
import { aiModels } from '#data/ai-models.ts'
import type { ContentLocale } from '#lib/content-types.ts'
import { useTranslations } from '#i18n/utils.ts'

interface Props {
  locale: ContentLocale
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<fieldset
  class="w-full rounded-lg border border-border bg-card p-3"
  x-init="window.dispatchEvent(new CustomEvent('go-slim:ai-model-status-request'))"
>
  <legend class="px-1 text-base font-semibold">
    {t('assistant.modelDownloadTitle')}
  </legend>
  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
    {t('assistant.modelDownloadDescription')}
  </p>
  <div class="mt-4 grid gap-2">
    {aiModels.map((model) => (
      <label
        class:list={[
          'group flex w-full cursor-pointer items-center gap-3 rounded-md border border-border bg-background px-3 py-3 text-start transition-colors hover:border-primary/50 hover:bg-accent has-checked:border-primary has-checked:bg-primary/5 has-focus-visible:ring-3 has-focus-visible:ring-outline/50',
          model.provider === 'cloudflare' && 'has-disabled:cursor-not-allowed has-disabled:opacity-50',
        ]}
      >
        <input
          type="radio"
          name="assistant-model"
          value={model.id}
          x-model="$store.ai.modelChoiceId"
          :disabled={model.provider === 'cloudflare'
            ? "$store.ai.cloudflareState === 'exhausted' || $store.ai.cloudflareState === 'unavailable'"
            : undefined}
          class="peer sr-only"
        />
        <Icon
          name={model.provider === 'local' ? 'tabler:cpu' : 'tabler:cloud-computing'}
          class="size-5 shrink-0 text-muted-foreground"
          aria-hidden="true"
        />
        <span class="min-w-0 flex-1">
          <span class="flex flex-wrap items-center gap-2">
            <span class="font-semibold">{model.label}</span>
            {model.recommended && (
              <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[0.6875rem] font-medium text-primary">
                {t('assistant.modelRecommended')}
              </span>
            )}
            {model.provider === 'local' && 'highMemory' in model && model.highMemory && (
              <span class="rounded-full bg-warning/10 px-2 py-0.5 text-[0.6875rem] font-medium text-warning">
                {t('assistant.modelHighMemory')}
              </span>
            )}
          </span>
          {model.provider === 'local' ? (
            <>
              <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
                {t('assistant.modelFirstDownload')} ≈ {model.downloadSize}
                <span aria-hidden="true"> · </span>
                {t('assistant.modelGpuMemory')} ≈ {model.gpuMemory}
              </span>
              <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
                {t('assistant.modelDownloadPrivacy')}
              </span>
            </>
          ) : (
            <>
              <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
                {t('assistant.cloudflareProfile')}
                <span x-cloak x-show="$store.ai.cloudflareState === 'checking'"> · {t('assistant.cloudflareChecking')}</span>
                <span x-cloak x-show="$store.ai.cloudflareState === 'available'"> · {t('assistant.cloudflareAvailable')}</span>
                <span x-cloak x-show="$store.ai.cloudflareState === 'low'"> · {t('assistant.cloudflareLow')}</span>
                <span x-cloak x-show="$store.ai.cloudflareState === 'exhausted'"> · {t('assistant.cloudflareExhausted')}</span>
                <span x-cloak x-show="$store.ai.cloudflareState === 'unavailable'"> · {t('assistant.cloudflareUnavailable')}</span>
              </span>
              <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
                {t('assistant.cloudflarePrivacy')}
              </span>
            </>
          )}
        </span>
        <Icon
          name="tabler:check"
          class="size-5 shrink-0 text-primary opacity-0 transition-opacity peer-checked:opacity-100"
          aria-hidden="true"
        />
      </label>
    ))}
  </div>

  <div class="mt-4 flex flex-wrap justify-end gap-2">
    <Button
      type="button"
      variant="ghost"
      size="sm"
      class="px-3 text-muted-foreground"
      @click="$store.ai.dismissModelSelection(question.id)"
    >
      {t('assistant.modelNotNow')}
    </Button>
    <Button
      type="button"
      variant="primary"
      size="sm"
      class="px-3"
      :disabled="$store.ai.modelChoiceId.startsWith('cloudflare:') && ($store.ai.cloudflareState === 'exhausted' || $store.ai.cloudflareState === 'unavailable')"
      @click="$store.ai.confirmModelSelection(question.id)"
    >
      <Icon name="tabler:check" class="size-4" aria-hidden="true" />
      {t('assistant.modelDownloadAction')}
    </Button>
  </div>
</fieldset>
