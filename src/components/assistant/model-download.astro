---
import { Icon } from 'astro-icon/components'
import Button from '#components/ui/button/index.astro'
import { localAiModels } from '#data/ai-models.ts'
import type { ContentLocale } from '#lib/content-types.ts'
import { useTranslations } from '#i18n/utils.ts'

interface Props {
  locale: ContentLocale
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<fieldset class="w-full rounded-lg border border-border bg-card p-3">
  <legend class="px-1 text-base font-semibold">
    {t('assistant.modelDownloadTitle')}
  </legend>
  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
    {t('assistant.modelDownloadDescription')}
  </p>
  <p class="mt-2 flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
    <Icon
      name="tabler:shield-lock"
      class="mt-0.5 size-4 shrink-0 text-primary"
      aria-hidden="true"
    />
    <span>{t('assistant.modelDownloadPrivacy')}</span>
  </p>

  <div class="mt-4 grid gap-2">
    {localAiModels.map((model) => (
      <label
        class="group flex w-full cursor-pointer items-center gap-3 rounded-md border border-border bg-background px-3 py-3 text-start transition-colors hover:border-primary/50 hover:bg-accent has-checked:border-primary has-checked:bg-primary/5 has-focus-visible:ring-3 has-focus-visible:ring-outline/50"
      >
        <input
          type="radio"
          name="assistant-local-model"
          value={model.id}
          x-model="$store.ai.modelChoiceId"
          class="peer sr-only"
        />
        <span class="min-w-0 flex-1">
          <span class="flex flex-wrap items-center gap-2">
            <span class="font-semibold">{model.label}</span>
            {model.recommended && (
              <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[0.6875rem] font-medium text-primary">
                {t('assistant.modelRecommended')}
              </span>
            )}
            {'highMemory' in model && model.highMemory && (
              <span class="rounded-full bg-warning/10 px-2 py-0.5 text-[0.6875rem] font-medium text-warning">
                {t('assistant.modelHighMemory')}
              </span>
            )}
          </span>
          <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
            {t('assistant.modelFirstDownload')} ≈ {model.downloadSize}
            <span aria-hidden="true"> · </span>
            {t('assistant.modelGpuMemory')} ≈ {model.gpuMemory}
          </span>
        </span>
        <Icon
          name="tabler:check"
          class="size-5 shrink-0 text-primary opacity-0 transition-opacity peer-checked:opacity-100"
          aria-hidden="true"
        />
      </label>
    ))}
  </div>

  <div class="mt-4 flex flex-wrap justify-end gap-2">
    <Button
      type="button"
      variant="ghost"
      size="sm"
      class="px-3 text-muted-foreground"
      @click="$store.ai.dismissModelSelection(question.id)"
    >
      {t('assistant.modelNotNow')}
    </Button>
    <Button
      type="button"
      variant="primary"
      size="sm"
      class="px-3"
      @click="$store.ai.confirmModelSelection(question.id)"
    >
      <Icon name="tabler:download" class="size-4" aria-hidden="true" />
      {t('assistant.modelDownloadAction')}
    </Button>
  </div>
</fieldset>
