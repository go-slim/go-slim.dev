---
import BaseLayout from '#components/layouts/base.astro'
import MaintainersPage from '#components/views/maintainers-page/index.astro'
import { useTranslations } from '#i18n/utils.ts'

const locale = 'zh-Hans' as const
const t = useTranslations(locale)
---

<BaseLayout
  locale={locale}
  title={t('meta.maintainers.title')}
  description={t('meta.maintainers.description')}
>
  <MaintainersPage locale={locale} />
</BaseLayout>
